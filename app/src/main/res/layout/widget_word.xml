<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_red" />
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="5dp" android:src="@drawable/dot_yellow" />
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="5dp" android:src="@drawable/dot_green" />
        <TextView
            android:id="@+id/w_meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_sub"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Mnemo" />
        <TextView
            android:id="@+id/w_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#5E5CE6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="↻" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_word"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/widget_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="28sp"
        android:text="Mnemo" />

    <TextView
        android:id="@+id/w_trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#5E5CE6"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Otwórz aplikację, aby zacząć" />
</LinearLayout>
